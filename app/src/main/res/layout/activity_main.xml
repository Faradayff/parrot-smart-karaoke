<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:paddingLeft="14dp"
    android:paddingRight="14dp"
    android:paddingTop="8dp"
    android:paddingBottom="6dp">

    <!-- Header: cover (only when it has art) + track info + transport row +
         settings gear. The cover starts GONE so an empty track does not show
         a grey square; it appears (and pushes the title right) when the
         relay sends a cover image. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/cover"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginRight="10dp"
            android:background="@color/coverBg"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="@color/title"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="@color/subtitle"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnPrev"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginLeft="8dp"
            android:background="@null"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_prev" />

        <ImageButton
            android:id="@+id/btnPlayPause"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginLeft="6dp"
            android:background="@null"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_play" />

        <ImageButton
            android:id="@+id/btnNext"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginLeft="6dp"
            android:background="@null"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_next" />

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginLeft="10dp"
            android:background="@null"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_settings_gear" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="6dp"
        android:layout_marginTop="8dp"
        android:background="@color/divider" />

    <!-- Body: three exclusive states -->
    <FrameLayout
        android:id="@+id/body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Karaoke band: prev1 is always pinned near the top and
             next1+next2 always pinned near the bottom (they never move when
             the current line grows or shrinks); the big current line takes
             the whole space between and stays centered in it, with the v1.8
             spacing around the neighbours. The current line may wrap to 3
             (or 4) lines; from 3 lines on it is auto-shrunk in code (see
             fitCurrentLine, floor 18sp + verifyCurrentFits post-layout
          correction) until it reads as 2 lines.
             @+id/current intentionally sets NO ellipsize — on Android 2.3.7
             ellipsize truncates the text early (to 2 lines) regardless of
             maxLines, so we let it wrap fully instead. -->
        <LinearLayout
            android:id="@+id/band"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:id="@+id/prev1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="14dp"
                android:layout_marginTop="2dp"
                android:layout_marginRight="14dp"
                android:layout_marginBottom="6dp"
                android:ellipsize="end"
                android:gravity="center"
                android:singleLine="true"
                android:textColor="@color/other"
                android:textSize="18sp" />

            <!-- IMPORTANT (Android 2.3.7): current must be a DIRECT child of
                 this vertical LinearLayout. Wrapped in a FrameLayout with
                 margins, Gingerbread measures the child wider than its final
                 bounds, so long lines are wrapped at a bigger width than the
                 box and then clipped at both ends (in-car screenshots v1.9.9:
                 'A' and 'la' cut mid-glyph). In a LinearLayout the measured and
                 laid-out widths always agree (v1.8 layout never clipped).
                 height=0+weight=1 + gravity=center keeps it vertically
                 centered between prev1 and next1. -->
            <TextView
                android:id="@+id/current"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginLeft="14dp"
                android:layout_marginRight="14dp"
                android:gravity="center"
                android:maxLines="4"
                android:textColor="@color/currentActive"
                android:textSize="34sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/next1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="14dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginRight="14dp"
                    android:layout_marginBottom="2dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:singleLine="true"
                    android:textColor="@color/other"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/next2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="14dp"
                    android:layout_marginTop="1dp"
                    android:layout_marginRight="14dp"
                    android:layout_marginBottom="1dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:singleLine="true"
                    android:textColor="@color/other"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Plain (unsynced) lyrics -->
        <ScrollView
            android:id="@+id/plainScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <TextView
                android:id="@+id/plainText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:paddingTop="4dp"
                android:paddingBottom="8dp"
                android:textColor="@color/plainText"
                android:textSize="17sp" />
        </ScrollView>

        <!-- State message -->
        <LinearLayout
            android:id="@+id/msgBox"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/msgMain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/message"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/msgDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:textColor="@color/messageDetail"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/retryLine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:singleLine="true"
                android:textColor="@color/message"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- TEMPORARY in-car diagnostic (v1.9.11-dbg): red outline around the
             @+id/current box + yellow live text metrics. REMOVE before any
             real release once the car layout behavior is understood. -->
        <me.farnasx.parrotkaraoke.DebugBoundsView
            android:id="@+id/debugBounds"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <TextView
        android:id="@+id/footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:singleLine="true"
        android:textColor="@color/footerColor"
        android:textSize="11sp" />
</LinearLayout>
