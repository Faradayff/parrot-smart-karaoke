<?xml version="1.0" encoding="utf-8"?>
<!-- Warning-action button: orange border + orange text on a dark orange fill,
     with a visibly pressed state and a dimmed disabled state
     (the API 10 theme has no ripples, so the selector carries the feedback).
     Same scheme as btn_danger, one step down from red: it drops ONE song's
     cached lyric instead of wiping the whole cache. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/warningBgDisabled" />
            <corners android:radius="4dp" />
            <stroke android:width="1dp" android:color="@color/warningBorderDisabled" />
        </shape>
    </item>

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/warningBgPressed" />
            <corners android:radius="4dp" />
            <stroke android:width="1dp" android:color="@color/warning" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/warningBg" />
            <corners android:radius="4dp" />
            <stroke android:width="1dp" android:color="@color/warning" />
        </shape>
    </item>

</selector>
