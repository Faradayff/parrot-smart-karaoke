<?xml version="1.0" encoding="utf-8"?>
<!-- Dangerous-action button: red border + red text on a dark red fill,
     with a visibly pressed state and a dimmed disabled state
     (the API 10 theme has no ripples, so the selector carries the feedback). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/dangerBgDisabled" />
            <corners android:radius="4dp" />
            <stroke android:width="1dp" android:color="@color/dangerBorderDisabled" />
        </shape>
    </item>

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/dangerBgPressed" />
            <corners android:radius="4dp" />
            <stroke android:width="1dp" android:color="@color/danger" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/dangerBg" />
            <corners android:radius="4dp" />
            <stroke android:width="1dp" android:color="@color/danger" />
        </shape>
    </item>

</selector>
